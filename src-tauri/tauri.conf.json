{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stylus",
  "version": "0.4.1",
  "identifier": "com.kass.stylus",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Stylus",
        "width": 1000,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' cover: https://*.scdn.co https://*.spotifycdn.com data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxNDA4NjM1RkRFRkE2MjEKUldRaHB1LzlOWVpBSVhISWJjOGkzT3ZSZVdFK0hsNEhKOE9vYUszbnNUSDl3S3RYMTQ1eEczOUYK",
      "endpoints": [
        "https://github.com/SandQuattro/stylus-spotify-mini-player/releases/latest/download/latest.json"
      ]
    }
  }
}
